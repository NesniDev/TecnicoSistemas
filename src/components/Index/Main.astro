---
import ComputerAnimated from '@components/Index/ComputerAnimated.astro'
import Button from '@components/Shared/Button.astro'
import Container from '@components/Shared/Container.astro'
import ArrowNews from '@assets/icons/ArrowNews.astro'
import ArticleMain from '@components/Index/ArticleMain.astro'
import { tips } from '@lib/tips'
import Check from '@assets/icons/Check.astro'
import { news } from '@lib/news-backup'

interface NewsItem {
  title: string
  description: string
  url: string
  image_url: string
  published_at: string
  snippet: string
}

let dataNews: NewsItem[] = []

try {
  if (process.env.NODE_ENV === 'production') {
    const resNews = await fetch('https://infobyte.neider.dev/api/get-news')
    if (resNews.ok) {
      dataNews = await resNews.json()
    } else {
      dataNews = news
    }
  }
} catch {
  dataNews = news
}

function formatDate(dateStr: string): string {
  try {
    return new Intl.DateTimeFormat('es-ES', {
      day: 'numeric',
      month: 'short',
      year: 'numeric'
    }).format(new Date(dateStr))
  } catch {
    return dateStr.slice(0, 10)
  }
}
---

<main id="contenido" class="flex items-center my-5 mx-5 lg:mx-auto flex-col">
  <Container>
    <div class="flex flex-col gap-5">
      <!-- Hero Section -->
      <section class="hero-section relative my-4 sm:my-10">
        <div class="hero-content">
          <!-- Top: Badge + Title -->
          <div class="hero-top">
            <div class="hero-badge">
              <span class="hero-badge-pulse"></span>
              <span>Tecnología en evolución</span>
            </div>

            <h1 class="hero-title">
              <span class="hero-title-white">Innovación y Futuro en el</span>
              <span class="hero-title-gradient">Mundo de los Sistemas</span>
            </h1>

            <p class="hero-desc">
              Un entorno creado para aprendices y expertos del área técnica en
              sistemas, donde podrás acceder a contenido actualizado sobre
              innovación tecnológica, soporte informático, hardware y
              programación.
            </p>
          </div>

          <!-- Glowing Divider Line -->
          <div class="hero-divider">
            <div class="hero-divider-line"></div>
            <div class="hero-divider-dot"></div>
            <div class="hero-divider-line"></div>
          </div>

          <ComputerAnimated />

          <!-- Bottom: Actions + Tags -->
          <div class="hero-bottom">
            <div class="hero-actions">
              <Button href="/recursos" className="px-6 py-2.5 text-sm">
                Explorar Recursos
              </Button>
              <div class="hero-btn-ghost">
                <a href="#news-latest" class="hover:translate-y-0.5">
                  Ver Noticias
                </a>
                <ArrowNews class="size-4" />
              </div>
            </div>

            <div class="hero-tags">
              <span class="hero-tag">Hardware</span>
              <span class="hero-tag">Redes</span>
              <span class="hero-tag">Programación</span>
              <span class="hero-tag">Soporte TI</span>
              <span class="hero-tag">Innovación</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Tips Section -->
      <section class="mb-6">
        <h2 class="mt-7 text-center text-2xl text-white font-extrabold">
          Consejos Prácticos para el Éxito en Sistemas e Informática
        </h2>
        <p class="text-center my-5 text-[var(--letter)]/60">
          Pequeñas dosis de conocimiento para fortalecer tus habilidades
          técnicas y avanzar en tu formación profesional dentro del mundo de la
          tecnología.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {
            tips.map((item) => (
              <div class="flex flex-col gap-3 bg-[#040d1c]/80 hover:bg-[#040d1c] border border-white/5 hover:border-white/10 text-white rounded-xl px-6 py-5 transition-all duration-200 hover:scale-[1.01]">
                <div class="flex items-center gap-3">
                  <Check class="size-7 text-[var(--colorAquamarine)] shrink-0" />
                  <h4 class="text-lg font-bold">{item.title}</h4>
                </div>
                <p class="text-sm text-[var(--letter)]/70 leading-relaxed">
                  {item.description}
                </p>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </Container>

  <!-- Parallax Info Section -->
  <section class="parallax-section mb-10">
    <div class="parallax-content">
      <h2 class="parallax-title">Técnico en Sistemas e Informática</h2>
      <p class="parallax-desc">
        Es aquella persona encargada de la instalación, configuración y
        mantenimiento de los sistemas informáticos, equipo y redes de
        telecomunicación. Su función principal es asegurar la integración y el
        correcto funcionamiento de todos los sistemas tecnológicos en la
        empresa.
      </p>
      <Button href="/post/blogTecnicoSistemas">Leer más...</Button>
    </div>
  </section>

  <!-- Latest News -->
  <Container>
    <h3
      class="text-2xl my-7 text-center md:text-left text-white font-extrabold"
      id="news-latest"
    >
      Últimas noticias
    </h3>
    <section class="news-grid mb-8">
      {
        //@ts-ignore
        dataNews.data
          ? //@ts-ignore
            dataNews.data.map((item: NewsItem) => <ArticleMain {...item} />)
          : news.slice(0, 3).map((item: NewsItem) => <ArticleMain {...item} />)
      }
    </section>
  </Container>

  <style>
    /* ===== HERO ===== */
    .hero-section {
      position: relative;
      padding: 2rem 1rem 1rem;
    }

    .hero-scroll-section {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .hero-scroll-section::-webkit-scrollbar {
      display: none;
    }

    .hero-scroll-track {
      display: flex;
      gap: 1.5rem;
      padding: 1rem 2rem;
      width: max-content;
    }

    .hero-scroll-item {
      flex-shrink: 0;
    }

    .hero-content {
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
      max-width: 800px;
      margin: 0 auto;
    }

    /* Top: Badge + Title */
    .hero-top {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      text-align: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 5px 14px;
      border-radius: 9999px;
      border: 1px solid rgba(100, 255, 218, 0.15);
      background: rgba(100, 255, 218, 0.04);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--colorAquamarine);
      animation: fadeInDown 0.5s ease both;
    }

    .hero-badge-pulse {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--colorAquamarine);
      animation: badgePulse 2s ease-in-out infinite;
    }

    @keyframes badgePulse {
      0%,
      100% {
        box-shadow: 0 0 0 0 rgba(100, 255, 218, 0.5);
      }
      50% {
        box-shadow: 0 0 0 6px rgba(100, 255, 218, 0);
      }
    }

    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .hero-title {
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 3rem;
      font-weight: 800;
      line-height: 1.05;
      letter-spacing: -0.03em;
    }

    .hero-title-white {
      color: white;
      animation: heroUp 0.6s ease 0.1s both;
    }

    .hero-title-gradient {
      background: linear-gradient(
        135deg,
        var(--colorAquamarine) 0%,
        #3b82f6 40%,
        var(--colorAquamarine) 80%
      );
      background-size: 200% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation:
        heroUp 0.6s ease 0.2s both,
        shimmer 3s linear infinite;
    }

    @keyframes heroUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes shimmer {
      0% {
        background-position: 0% center;
      }
      100% {
        background-position: 200% center;
      }
    }

    .hero-desc {
      max-width: 500px;
      color: rgba(205, 215, 247, 0.5);
      font-size: 0.9rem;
      line-height: 1.7;
      animation: heroUp 0.6s ease 0.3s both;
    }

    /* Glowing Divider */
    .hero-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      max-width: 400px;
      margin: 2rem 0;
      animation: heroUp 0.6s ease 0.35s both;
    }

    .hero-divider-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(100, 255, 218, 0.25),
        transparent
      );
    }

    .hero-divider-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--colorAquamarine);
      box-shadow: 0 0 12px rgba(100, 255, 218, 0.4);
      animation: dividerPulse 2.5s ease-in-out infinite;
    }

    @keyframes dividerPulse {
      0%,
      100% {
        box-shadow: 0 0 8px rgba(100, 255, 218, 0.3);
      }
      50% {
        box-shadow: 0 0 20px rgba(100, 255, 218, 0.6);
      }
    }

    /* Bottom: Actions + Tags */
    .hero-bottom {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      margin-top: 2rem;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      animation: heroUp 0.6s ease 0.5s both;
    }

    .hero-btn-ghost {
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      padding: 10px 20px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.02);
      color: var(--colorAquamarine);
      font-size: 0.875rem;
      font-weight: 500;
      transition: all 0.25s ease;
      transform: translateY(0px);
    }

    .hero-btn-ghost:hover {
      background: rgba(100, 255, 218, 0.06);
      border-color: rgba(100, 255, 218, 0.25);
      transform: translateY(-2px);
    }

    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      animation: heroUp 0.6s ease 0.6s both;
    }

    .hero-tag {
      padding: 4px 12px;
      border-radius: 6px;
      font-size: 0.7rem;
      font-weight: 500;
      color: rgba(205, 215, 247, 0.4);
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.04);
      transition: all 0.2s ease;
      cursor: default;
    }

    .hero-tag:hover {
      color: var(--colorAquamarine);
      border-color: rgba(100, 255, 218, 0.15);
      background: rgba(100, 255, 218, 0.04);
    }

    /* Responsive */
    @media (max-width: 640px) {
      .hero-title {
        font-size: 2.15rem;
      }
      .hero-section {
        padding: 1.5rem 0.5rem 0.5rem;
      }
    }

    .parallax-section {
      position: relative;
      width: 100vw;
      /* margin-left: calc(-50vw + 50%); */
      min-height: 400px;
      background:
        linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.6) 80%,
          rgba(226, 223, 223, 0) 100%
        ),
        url('/images/tecnico%20sistemas.webp');
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
      background-attachment: fixed;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      padding: 60px 40px;
    }

    .parallax-content {
      text-align: center;
      z-index: 10;
      max-width: 700px;
    }

    .parallax-title {
      font-size: 2.5rem;
      font-weight: 800;
      color: white;
      line-height: 1.15;
      text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
      margin-bottom: 1rem;
    }

    .parallax-desc {
      color: rgba(204, 214, 246, 0.85);
      font-size: 1rem;
      line-height: 1.7;
      margin-bottom: 1.5rem;
    }

    .news-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
    }

    @media (max-width: 768px) {
      .parallax-section {
        min-height: 300px;
        padding: 40px 20px;
      }

      .parallax-title {
        font-size: 1.75rem;
      }

      .parallax-desc {
        font-size: 0.9rem;
      }

      .news-grid {
        margin-inline: 0;
      }
    }
  </style>
</main>
