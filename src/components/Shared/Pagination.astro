---
interface Props {
  totalPages: number
  search?: string
  category?: string
  emptyMessage?: string
}

const { totalPages, search, category, emptyMessage = '' } = Astro.props

const url = Astro.url
const page = Number(url.searchParams.get('page') ?? 1)
const currentPage = Math.max(page > totalPages ? totalPages : page, 1)
const path = url.pathname

const searchParam = search ? `&search=${search}` : ''
const categoryParam = category ? `&category=${category}` : ''
const extraParams = `${searchParam}${categoryParam}`
---

<div
  class="flex flex-col sm:flex-row items-center justify-center my-10 gap-3 mx-auto w-full"
>
  {
    totalPages !== 0 ? (
      <>
        <a
          class:list={[
            "px-4 py-2 text-sm font-medium rounded-lg transition-colors duration-200",
            currentPage === 1
              ? "bg-[#112240]/60 text-[#8892b0]/50 border border-[#1a3350] pointer-events-none cursor-not-allowed"
              : "bg-[#112240]/60 text-[#ccd6f6] border border-[#1a3350] hover:border-[#64ffda]/50 hover:text-[#64ffda]"
          ]}
          href={`${path}?page=${Math.max(currentPage - 1, 1)}${extraParams}`}
        >
          ← Anterior
        </a>
        <span class="text-sm text-[#8892b0] font-mono">
          {currentPage} / {totalPages}
        </span>
        <a
          class:list={[
            "px-4 py-2 text-sm font-medium rounded-lg transition-colors duration-200",
            currentPage >= totalPages
              ? "bg-[#112240]/60 text-[#8892b0]/50 border border-[#1a3350] pointer-events-none cursor-not-allowed"
              : "bg-[#112240]/60 text-[#ccd6f6] border border-[#1a3350] hover:border-[#64ffda]/50 hover:text-[#64ffda]"
          ]}
          href={`${path}?page=${Math.min(currentPage + 1, totalPages)}${extraParams}`}
        >
          Siguiente →
        </a>
      </>
    ) : (
      <p class="text-[#8892b0] text-sm">{emptyMessage}</p>
    )
  }
</div>
