    <p>&copy; {currentYear} InfoByte — Técnico en Sistemas IFE</p>
    <div class="flex gap-4">
      <a href="/contacto" class="hover:text-[var(--colorAquamarine)] transition-colors">Contacto</a>
      <a href="/privacidad" class="hover:text-[var(--colorAquamarine)] transition-colors">Privacidad</a>
      <a href="https://www.facebook.com/InstitutoIFE" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--colorAquamarine)] transition-colors">Facebook</a>
    </div>
  </div>
