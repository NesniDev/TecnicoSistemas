---
interface Props {
  href: string
  className?: string
  openBlank?: boolean
  ariaLabel?: string
}

const { href, className, openBlank, ariaLabel } = Astro.props
---

<a
  href={href}
  target={openBlank ? '_blank' : '_self'}
  rel={openBlank ? 'noopener noreferrer' : undefined}
  aria-label={ariaLabel}
  class:list={[
    'bg-[var(--colorAquamarine)] active:scale-[0.95] rounded-lg hover:opacity-80 text-sm text-[var(--fondo)] font-semibold transition-all duration-200 inline-flex items-center justify-center',
    className || 'px-3 py-2',
  ]}
>
  <slot />
</a>
