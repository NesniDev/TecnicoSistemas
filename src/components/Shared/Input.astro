---
interface Props {
  name: string
  type?: string
  label: string
  placeholder?: string
  value?: string
  required?: boolean
  autocomplete?: string
  icon?: string
}

const {
  name,
  type = 'text',
  label,
  placeholder = '',
  value = '',
  required = false,
  autocomplete = 'off',
  icon,
} = Astro.props
---

<label for={name} class="flex flex-col gap-1.5">
  <span class="text-sm text-[#ccd6f6] font-medium">{label}</span>
  <div class="relative">
    {
      icon && (
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[#8892b0] pointer-events-none">
          <Fragment set:html={icon} />
        </span>
      )
    }
    <input
      id={name}
      name={name}
      type={type}
      value={value}
      placeholder={placeholder}
      required={required}
      autocomplete={autocomplete}
      class:list={[
        'w-full py-2.5 text-sm text-[#ccd6f6] bg-[#112240]/60 border border-[#1a3350] rounded-lg outline-none transition-colors duration-200 placeholder:text-[#8892b0]/60',
        'focus:border-[#64ffda]/50',
        icon ? 'pl-10 pr-4' : 'px-4',
      ]}
    />
  </div>
</label>
