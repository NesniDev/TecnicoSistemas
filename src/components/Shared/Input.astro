---
interface Props {
  name: string
  type?: string
  label: string
  placeholder?: string
  value?: string
  required?: boolean
  autocomplete?: string
  icon?: string
}

const {
  name,
  type = 'text',
  label,
  placeholder = '',
  value = '',
  required = false,
  autocomplete = 'off',
  icon,
} = Astro.props
---

<label for={name} class="flex flex-col gap-1.5">
  <span class="text-sm text-[var(--letter)]/80 font-medium">{label}</span>
  <div class="relative">
    {
      icon && (
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--letter)]/40 text-sm pointer-events-none">
          <Fragment set:html={icon} />
        </span>
      )
    }
    <input
      id={name}
      name={name}
      type={type}
      value={value}
      placeholder={placeholder}
      required={required}
      autocomplete={autocomplete}
      class:list={[
        'w-full py-2.5 bg-[#1f293a]/80 text-[var(--letter)] placeholder-[var(--letter)]/30 rounded-lg border border-white/10 transition-all duration-200 outline-none',
        'focus:border-[var(--colorAquamarine)]/50 focus:bg-[#1f293a] focus:ring-1 focus:ring-[var(--colorAquamarine)]/20',
        icon ? 'pl-10 pr-4' : 'px-4',
      ]}
    />
  </div>
</label>
