---

---

<!-- Login Modal -->
<div
  id="login-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Iniciar sesión"
>
  <div
    class="bg-[#0b192f] border border-[#1a3350] rounded-2xl max-w-md w-full mx-auto shadow-2xl relative overflow-hidden animate-modal"
  >
    <div
      class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#64ffda] via-[#5eead4] to-[#22d3ee]"
    >
    </div>

    <button
      id="btn-close-login"
      type="button"
      class="absolute top-4 right-4 text-[#8892b0] hover:text-white transition-colors cursor-pointer z-10"
      aria-label="Cerrar"
    >
      <svg
        class="size-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="px-8 pt-8 pb-6 text-center">
      <div
        class="size-14 mx-auto mb-4 rounded-2xl bg-[#64ffda]/10 border border-[#64ffda]/20 flex items-center justify-center"
      >
        <img src="/systems.svg" alt="InfoByte" class="size-8" />
      </div>
      <h2 class="text-xl font-bold text-white mb-1">Bienvenido a InfoByte</h2>
      <p class="text-sm text-[#8892b0]">
        Inicia sesión para desbloquear todo el contenido
      </p>
    </div>

    <div class="px-8 pb-6">
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <div
            class="size-9 shrink-0 rounded-lg bg-[#64ffda]/10 flex items-center justify-center"
          >
            <svg
              class="size-5 text-[#64ffda]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342"
              ></path>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-[#ccd6f6]">Cursos técnicos</p>
            <p class="text-xs text-[#8892b0]">
              Accede a todo el contenido de sistemas
            </p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div
            class="size-9 shrink-0 rounded-lg bg-[#64ffda]/10 flex items-center justify-center"
          >
            <svg
              class="size-5 text-[#64ffda]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
              ></path>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-[#ccd6f6]">
              Recursos descargables
            </p>
            <p class="text-xs text-[#8892b0]">
              Guías, PDFs y material de estudio
            </p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div
            class="size-9 shrink-0 rounded-lg bg-[#64ffda]/10 flex items-center justify-center"
          >
            <svg
              class="size-5 text-[#64ffda]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
              ></path>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-[#ccd6f6]">100% gratuito</p>
            <p class="text-xs text-[#8892b0]">
              Sin costos ocultos, sin tarjetas
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="px-8">
      <div class="h-px bg-[#1a3350]"></div>
    </div>

    <div class="px-8 py-6">
      <div
        id="modal-error"
        class="hidden mb-4 p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm text-center"
      >
      </div>

      <button
        id="btn-google-modal"
        type="button"
        class="w-full py-3.5 bg-white hover:bg-gray-100 text-gray-700 font-medium text-sm rounded-xl transition-all duration-200 flex items-center justify-center gap-3 active:scale-[0.98] cursor-pointer shadow-lg shadow-black/10"
      >
        <svg class="size-5" viewBox="0 0 24 24">
          <path
            fill="#4285F4"
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
          ></path>
          <path
            fill="#34A853"
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
          ></path>
          <path
            fill="#FBBC05"
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
          ></path>
          <path
            fill="#EA4335"
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
          ></path>
        </svg>
        Continuar con Google
      </button>

      <p class="text-center text-[11px] text-[#8892b0]/60 mt-4">
        Al continuar aceptas nuestros términos y política de privacidad
      </p>
    </div>
  </div>
</div>

<style>
  @keyframes modalIn {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .animate-modal {
    animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  import { signInWithPopup, GoogleAuthProvider } from 'firebase/auth'
  import { firebase } from '../../firebase/config'

  document.addEventListener('astro:page-load', () => {
    const modal = document.querySelector('#login-modal') as HTMLElement
    const btnOpen = document.querySelector(
      '#btn-open-login'
    ) as HTMLButtonElement
    const btnClose = document.querySelector(
      '#btn-close-login'
    ) as HTMLButtonElement
    const btnGoogle = document.querySelector(
      '#btn-google-modal'
    ) as HTMLButtonElement
    const modalError = document.querySelector('#modal-error') as HTMLDivElement

    if (!modal) return

    function openModal() {
      modal.classList.remove('hidden')
      modal.classList.add('flex')
    }

    function closeModal() {
      modal.classList.add('hidden')
      modal.classList.remove('flex')
      modalError.classList.add('hidden')
    }

    function showModalError(msg: string) {
      modalError.textContent = msg
      modalError.classList.remove('hidden')
    }

    btnOpen?.addEventListener('click', openModal)
    btnClose?.addEventListener('click', closeModal)
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal()
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden'))
        closeModal()
    })

    btnGoogle?.addEventListener('click', async () => {
      modalError.classList.add('hidden')
      btnGoogle.setAttribute('disabled', 'disabled')
      btnGoogle.innerHTML =
        '<svg class="size-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg> Conectando...'

      try {
        const result = await signInWithPopup(
          firebase.auth,
          new GoogleAuthProvider()
        )
        const user = result.user

        await fetch('/api/auth/google-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            uid: user.uid,
            email: user.email,
            displayName: user.displayName,
            photoURL: user.photoURL
          })
        })

        window.location.reload()
      } catch (err: any) {
        if (err.code !== 'auth/popup-closed-by-user') {
          showModalError('No se pudo completar el inicio de sesión con Google.')
        }
        btnGoogle.removeAttribute('disabled')
        btnGoogle.innerHTML =
          '<svg class="size-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg> Continuar con Google'
      }
    })
  })
</script>
