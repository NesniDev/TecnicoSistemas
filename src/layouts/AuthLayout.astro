---
// @ts-ignore
import '@fontsource-variable/outfit'
import '@styles/global.css'

import { ClientRouter } from 'astro:transitions'

interface Props {
  title: string
  page: string
}

const { title, page } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/systems.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex items-center justify-center p-4 sm:p-6">
    <!-- Animated Background -->
    <div class="page-bg">
      <div class="page-bg-grid"></div>
      <div class="page-particles">
        <span class="page-particle"></span>
        <span class="page-particle"></span>
        <span class="page-particle"></span>
        <span class="page-particle"></span>
        <span class="page-particle"></span>
        <span class="page-particle"></span>
        <span class="page-particle"></span>
        <span class="page-particle"></span>
      </div>
      <div class="page-glow page-glow-1"></div>
      <div class="page-glow page-glow-2"></div>
    </div>

    <main class="relative z-10 w-full max-w-md animate-blurred-fade-in">
      <div
        class="bg-[#0d1f35]/80 backdrop-blur-xl border border-white/10 rounded-2xl p-8 sm:p-10 shadow-2xl shadow-black/20"
      >
        <div class="text-center mb-8">
          <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Bienvenido al {page}
          </h1>
          <p class="text-sm text-[var(--letter)]/60 mt-2">
            Accede a tu panel de estudiante personalizado
          </p>
        </div>

        <slot />

        <div class="mt-8 pt-6 border-t border-white/5">
          <div class="flex flex-col gap-2.5 text-xs text-[var(--letter)]/50">
            <div class="flex items-center gap-2">
              <span class="text-[var(--colorAquamarine)]">▸</span>
              <span>Acceso instantáneo a tu panel personalizado</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[var(--colorAquamarine)]">▸</span>
              <span>Protege tus datos y privacidad</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[var(--colorAquamarine)]">▸</span>
              <span>Herramientas y recursos de aprendizaje</span>
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
