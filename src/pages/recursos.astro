---
import Container from '@components/Shared/Container.astro'
import Footer from '@components/Shared/Footer.astro'
import Header from '@components/Shared/Header.astro'
import ArticleResources from '@components/resources/ArticleResources.astro'
import Pagination from '@components/Shared/Pagination.astro'
import Layout from '@layouts/Layout.astro'
import { actions } from 'astro:actions'
import { names } from '@lib/name.courses'

const searchParams = Astro.url.searchParams

const page = Number(searchParams.get('page') ?? 1)
const search = searchParams.get('search') ?? undefined
const category = searchParams.get('category') ?? undefined

const { data, error } = await Astro.callAction(actions.getResourceByPage, {
  page,
  search,
  category
})

if (error) {
  return Astro.redirect('/')
}

const { resourcesByPage, totalPages } = data
---

<Layout
  title="Recursos Educativos y Tecnológicos | Aprende con InfoByte"
  description="Repositorio de materiales educativos, documentos, enlaces y herramientas útiles para estudiantes de tecnología. Recursos organizados por categorías."
>
  <Header />
  <Container>
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
      <div class="mb-8">
        <span class="text-xs font-mono text-[#64ffda] uppercase tracking-widest mb-2 block">Biblioteca</span>
        <h1 class="text-3xl sm:text-4xl font-bold text-[#ccd6f6] mb-3">Recursos Educativos</h1>
        <p class="text-[#8892b0] text-base max-w-2xl">
          Materiales de estudio, documentos y herramientas para complementar tu aprendizaje.
        </p>
      </div>

      <form method="GET" action="/recursos" role="search" class="mb-8">
        <div class="flex flex-col sm:flex-row gap-3">
          <div class="relative flex-1">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#8892b0]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              type="text"
              name="search"
              value={search}
              placeholder="Buscar recursos por título..."
              autocomplete="off"
              class="w-full pl-10 pr-4 py-2.5 text-sm text-[#ccd6f6] bg-[#112240]/60 border border-[#1a3350] rounded-lg outline-none focus:border-[#64ffda]/50 transition-colors placeholder:text-[#8892b0]/60"
            />
          </div>
          <button
            type="submit"
            class="px-5 py-2.5 text-sm font-medium text-[#0b192f] bg-[#64ffda] rounded-lg hover:bg-[#64ffda]/90 transition-colors duration-200"
          >
            Buscar
          </button>
        </div>

        <div class="mt-5">
          <span class="text-xs font-mono text-[#8892b0] uppercase tracking-wider mb-3 block">Categorías</span>
          <div class="flex flex-wrap gap-2">
            <a
              href="/recursos"
              class:list={[
                "px-3 py-1.5 text-xs font-medium rounded-md transition-colors duration-200",
                !category
                  ? "bg-[#64ffda]/15 text-[#64ffda] border border-[#64ffda]/30"
                  : "bg-[#112240]/60 text-[#8892b0] border border-[#1a3350] hover:border-[#64ffda]/30 hover:text-[#ccd6f6]"
              ]}
            >
              Todos
            </a>
            {names.map(({ name, nickName }) => (
              <button
                type="submit"
                name="category"
                value={name}
                class:list={[
                  "px-3 py-1.5 text-xs font-medium rounded-md transition-colors duration-200",
                  category === name
                    ? "bg-[#64ffda]/15 text-[#64ffda] border border-[#64ffda]/30"
                    : "bg-[#112240]/60 text-[#8892b0] border border-[#1a3350] hover:border-[#64ffda]/30 hover:text-[#ccd6f6]"
                ]}
              >
                {nickName}
              </button>
            ))}
          </div>
        </div>
      </form>

      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
        {resourcesByPage.map((item) => <ArticleResources {...item} />)}
      </section>

      <Pagination
        totalPages={totalPages}
        search={search}
        category={category}
        emptyMessage="No se encontraron recursos"
      />
    </main>
  </Container>
  <Footer />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector('form[role="search"]') as HTMLFormElement
    const btn = form?.querySelector('button[type="submit"]') as HTMLButtonElement

    form?.addEventListener('submit', () => {
      if (btn) {
        btn.textContent = 'Buscando...'
        btn.disabled = true
      }
    })
  })
</script>
