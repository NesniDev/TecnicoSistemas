---
import Container from '@components/Shared/Container.astro'
import Footer from '@components/Shared/Footer.astro'
import Header from '@components/Shared/Header.astro'
import ArticleResources from '@components/resources/ArticleResources.astro'
import Pagination from '@components/Shared/Pagination.astro'
import Layout from '@layouts/Layout.astro'
import { actions } from 'astro:actions'
import { names } from '@lib/name.courses'

const searchParams = Astro.url.searchParams

const page = Number(searchParams.get('page') ?? 1)
const search = searchParams.get('search') ?? undefined
const category = searchParams.get('category') ?? undefined

const { data, error } = await Astro.callAction(actions.getResourceByPage, {
  page,
  search,
  category
})

if (error) {
  return Astro.redirect('/')
}

const { resourcesByPage, totalPages } = data
---

<Layout
  title="Recursos Educativos y Tecnológicos | Aprende con InfoByte"
  description="Repositorio de materiales educativos, documentos, enlaces y herramientas útiles para estudiantes de tecnología. Recursos organizados por categorías."
>
  <Header />
  <Container>
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
      <div class="mb-8">
        <span class="text-xs font-mono text-[#64ffda] uppercase tracking-widest mb-2 block">Biblioteca</span>
        <h1 class="text-3xl sm:text-4xl font-bold text-[#ccd6f6] mb-3">Recursos Educativos</h1>
        <p class="text-[#8892b0] text-base max-w-2xl">
          Materiales de estudio, documentos y herramientas para complementar tu aprendizaje.
        </p>
      </div>

      <form method="GET" action="/recursos" role="search" class="mb-8 relative z-[300]">
        <div class="flex flex-col sm:flex-row gap-3">
          <div class="relative flex-1 z-[300]">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#8892b0]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              type="text"
              name="search"
              value={search}
              placeholder="Buscar recursos por título..."
              autocomplete="off"
              id="search-input"
              class="w-full pl-10 pr-4 py-2.5 text-sm text-[#ccd6f6] bg-[#112240]/60 border border-[#1a3350] rounded-lg outline-none focus:border-[#64ffda]/50 transition-colors placeholder:text-[#8892b0]/60"
            />
            <div id="suggestions" style="display:none;position:absolute;z-index:100;top:100%;left:0;right:0;margin-top:4px;background:#112240;border:1px solid #1a3350;border-radius:8px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,0.4);flex-direction:column;">
            </div>
          </div>
          <button
            type="submit"
            class="px-5 py-2.5 text-sm font-medium text-[#0b192f] bg-[#64ffda] rounded-lg hover:bg-[#64ffda]/90 transition-colors duration-200"
          >
            Buscar
          </button>
        </div>

        <div class="mt-5">
          <span class="text-xs font-mono text-[#8892b0] uppercase tracking-wider mb-3 block">Categorías</span>
          <div class="flex flex-wrap gap-2">
            <a
              href="/recursos"
              class:list={[
                "px-3 py-1.5 text-xs font-medium rounded-md transition-colors duration-200",
                !category
                  ? "bg-[#64ffda]/15 text-[#64ffda] border border-[#64ffda]/30"
                  : "bg-[#112240]/60 text-[#8892b0] border border-[#1a3350] hover:border-[#64ffda]/30 hover:text-[#ccd6f6]"
              ]}
            >
              Todos
            </a>
            {names.map(({ name, nickName }) => (
              <button
                type="submit"
                name="category"
                value={name}
                class:list={[
                  "px-3 py-1.5 text-xs font-medium rounded-md transition-colors duration-200",
                  category === name
                    ? "bg-[#64ffda]/15 text-[#64ffda] border border-[#64ffda]/30"
                    : "bg-[#112240]/60 text-[#8892b0] border border-[#1a3350] hover:border-[#64ffda]/30 hover:text-[#ccd6f6]"
                ]}
              >
                {nickName}
              </button>
            ))}
          </div>
        </div>
      </form>

      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
        {resourcesByPage.map((item) => <ArticleResources {...item} />)}
      </section>

      <Pagination
        totalPages={totalPages}
        search={search}
        category={category}
        emptyMessage="No se encontraron recursos"
      />
    </main>
  </Container>
  <Footer />
</Layout>

<script>
  function initSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement
    const box = document.getElementById('suggestions') as HTMLDivElement
    if (!input || !box) return

    let timer: ReturnType<typeof setTimeout>

    input.addEventListener('input', () => {
      clearTimeout(timer)
      const q = input.value.trim()
      if (q.length < 2) { box.style.display = 'none'; return }

      timer = setTimeout(async () => {
        const res = await fetch('/api/search-suggestions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: q, type: 'resource' })
        })
        const { suggestions } = await res.json()
        if (!suggestions?.length) { box.style.display = 'none'; return }

        box.innerHTML = suggestions.map((s: {title: string}) =>
          `<a href="/recursos?search=${encodeURIComponent(s.title)}" style="display:block;padding:10px 16px;color:#ccd6f6;font-size:14px;text-decoration:none;border-bottom:1px solid #1a3350;" onmouseover="this.style.background='#1a3350'" onmouseout="this.style.background='transparent'">${s.title}</a>`
        ).join('')
        box.style.display = 'block'
      }, 300)
    })

    box.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a')
      if (a) window.location.href = a.href
    })

    input.addEventListener('focus', () => {
      if (box.innerHTML) box.style.display = 'block'
    })

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target as Node) && !box.contains(e.target as Node)) {
        box.style.display = 'none'
      }
    })

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') box.style.display = 'none'
    })
  }

  document.addEventListener('astro:page-load', initSearch)
  document.addEventListener('DOMContentLoaded', initSearch)
</script>
