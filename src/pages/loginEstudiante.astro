---
import Layout from '@layouts/Layout.astro'
import { firebase } from '../firebase/config'
import Container from '@components/Shared/Container.astro'
import Header from '@components/Shared/Header.astro'

import ArticleLogin from '@components/loginEstudiante/ArticleLogin.astro'
import Footer from '@components/Shared/Footer.astro'
import ArchiveExplorer from '@assets/icons/RecursesExplorer.astro'
import LogoutIcon from '@assets/icons/Logout.astro'
import { events } from '../lib/events'
import Pagination from '@components/Shared/Pagination.astro'
import { actions } from 'astro:actions'

let firebaseUser = firebase.auth.currentUser
let sessionUser: { uid: string; email?: string; displayName?: string; photoURL?: string } | null = null

if (firebaseUser === null) {
  const sessionCookie = Astro.cookies.get('session')?.value
  if (sessionCookie) {
    try {
      sessionUser = JSON.parse(sessionCookie)
    } catch {}
  }
  if (!sessionUser) {
    return Astro.redirect('/')
  }
}

if (firebaseUser) {
  await firebaseUser.reload()
}

const displayName = firebaseUser?.displayName ?? sessionUser?.displayName ?? 'Anonimo'
const photoURL = firebaseUser?.photoURL ?? sessionUser?.photoURL ?? ''
const email = firebaseUser?.email ?? sessionUser?.email ?? ''
const metadata = firebaseUser?.metadata
const name = displayName ?? 'Anonimo'
const avatar =
  photoURL && photoURL.trim() !== ''
    ? photoURL
    : 'https://api.dicebear.com/7.x/adventurer/svg?seed=Neider'

const getGreeting = () => {
  const hour = new Date().getHours()
  if (hour < 12) return 'Buenos días'
  if (hour < 18) return 'Buenas tardes'
  return 'Buenas noches'
}
const greeting = getGreeting()

const joinDate = metadata?.creationTime
  ? new Date(metadata.creationTime).toLocaleDateString('es-CO', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : null

const lastSignIn = metadata?.lastSignInTime
  ? new Date(metadata.lastSignInTime).toLocaleDateString('es-CO', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    })
  : null

const searchParams = Astro.url.searchParams
const page = Number(searchParams.get('page') ?? 1)
const search = searchParams.get('search') ?? undefined

const { data, error } = await Astro.callAction(actions.getCourseByPage, {
  page,
  search
})

if (error) {
  // Handle error appropriately
  console.error(error)
  return Astro.redirect('/')
}

const { courses: coursesData, totalPage } = data

const { data: progressData } = await Astro.callAction(actions.getUserProgress, {
  uid: firebaseUser?.uid ?? sessionUser?.uid ?? ''
})

const userProgress = progressData?.progress ?? {}
---

<Layout
  title="Acceso para Estudiantes | Inicia Sesión en InfoByte para consultar la información de los cursos y más..."
  description="Página destinada al inicio de sesión de los usuarios. Permite autenticar credenciales y acceder a servicios privados o secciones personalizadas dentro de la plataforma."
>
  <Header />
  <Container>
    <div class="flex flex-col gap-2 mx-auto justify-center items-center">
      <div
        class="flex items-center gap-2 animate-fade-in-up w-full mx-10 md:mx-0"
      >
        <div class="flex flex-col my-5 flex-1">
          <h1 class="text-4xl text-center sm:text-left text-white">
            {greeting}, {name.split(' ')[0]}!
          </h1>
          <div
            class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-400 mt-1 select-none"
          >
            {email && <span>{email}</span>}
            {joinDate && <span class="text-gray-500">|</span>}
            {joinDate && <span>Miembro desde {joinDate}</span>}
          </div>
        </div>
        <button
          type="button"
          id="logout"
          class="flex items-center gap-2 px-4 py-2 text-sm text-[#8892b0] hover:text-red-400 bg-[#112240]/60 border border-[#1a3350] hover:border-red-400/30 rounded-lg transition-colors duration-200 cursor-pointer shrink-0"
        >
          <LogoutIcon class="size-4 shrink-0" />
          <span class="hidden sm:inline">Salir</span>
        </button>
      </div>
      <div
        class="flex justify-center items-center animate-fade-in-up w-full max-w-xl mx-auto px-4 md:px-0 relative z-[300]"
      >
        <form
          method="GET"
          action="/loginEstudiante"
          role="search"
          class="w-full relative z-[300]"
        >
          <div class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1 z-[300]">
              <svg
                class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#8892b0]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
              <input
                type="text"
                name="search"
                placeholder="Buscar cursos por título..."
                value={search}
                autocomplete="off"
                id="search-input"
                class="w-full pl-10 pr-4 py-2.5 text-sm text-[#ccd6f6] bg-[#112240]/60 border border-[#1a3350] rounded-lg outline-none focus:border-[#64ffda]/50 transition-colors placeholder:text-[#8892b0]/60"
              />
              <div
                id="suggestions"
                style="display:none;position:absolute;z-index:100;top:100%;left:0;right:0;margin-top:4px;background:#112240;border:1px solid #1a3350;border-radius:8px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,0.4);flex-direction:column;"
              >
              </div>
            </div>
            <button
              type="submit"
              class="px-5 py-2.5 text-sm font-medium text-[#0b192f] bg-[#64ffda] rounded-lg hover:bg-[#64ffda]/90 transition-colors duration-200"
            >
              Buscar
            </button>
          </div>
        </form>
      </div>
    </div>

    <main
      class="flex flex-col md:flex-row justify-between gap-5 mb-6 animate-fade-in-up"
    >
      <div class="flex flex-col mx-auto">
        <h2 class="text-2xl text-white my-5 mx-10 md:mx-0">Mis Cursos</h2>
        <section
          class="mx-10 md:mx-0 grid grid-cols-1 sm:grid-cols-2 place-items-center gap-5"
          id="list-courses"
        >
          {
            coursesData.length > 0 ? (
              coursesData.map((item, index) => (
                <div
                  class="stagger-item"
                  style={`animation-delay: ${index * 120}ms`}
                >
                  <ArticleLogin
                    {...item}
                    progress={userProgress[item.slug] ?? 0}
                  />
                </div>
              ))
            ) : (
              <div class="col-span-full flex flex-col items-center justify-center py-12 gap-4">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="48"
                  height="48"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-gray-500"
                >
                  <>
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M15 21h-9a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v5" />
                    <path d="M10 17l4 -5" />
                    <path d="M15 17l-4 -5" />
                    <path d="M6 12h.01" />
                    <path d="M18 12h.01" />
                  </>
                </svg>
                <p class="text-gray-400 text-lg text-center">
                  No se encontraron cursos
                </p>
                <a
                  href="/loginEstudiante"
                  class="bg-[#00a2ff] hover:bg-[#00a2ff]/80 text-white rounded-lg px-5 py-2 text-sm font-medium transition-all duration-200 active:scale-95"
                >
                  Ver todos los cursos
                </a>
              </div>
            )
          }
        </section>
        <Pagination totalPages={totalPage} search={search} />
      </div>
      <aside class="mx-10 md:mx-0">
        <div class="flex flex-col">
          <h2 class="text-2xl text-center sm:text-left text-white my-5">
            Recursos Educativos
          </h2>
          <a
            href="/recursos"
            class="group relative flex items-center gap-4 bg-gradient-to-br from-[#040d1c] via-[#0a1f3a] to-[#040d1c] text-white rounded-xl px-3 py-2 border border-gray-700/30 transition-all duration-500 overflow-hidden hover:-translate-y-0.5 hover:shadow-xl hover:shadow-[#64ffda]/10"
          >
            <div
              class="absolute inset-0 bg-gradient-to-br from-[#64ffda]/5 via-transparent to-[#00a2ff]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>
            <div
              class="relative flex items-center justify-center size-6 shrink-0 rounded-lg bg-gradient-to-br from-[#64ffda]/20 to-[#00a2ff]/20 group-hover:from-[#64ffda]/30 group-hover:to-[#00a2ff]/30 transition-all duration-500 group-hover:scale-110"
            >
              <ArchiveExplorer
                class="size-4 text-[#64ffda] group-hover:text-white transition-colors duration-300"
              />
            </div>
            <div class="relative flex flex-col gap-0.5">
              <span
                class="text-sm mt-1 font-semibold group-hover:text-[#64ffda] transition-colors duration-300"
                >Explorar todos los recursos</span
              >
              <span
                class="text-[10px] text-gray-500 group-hover:text-gray-400 transition-colors duration-300"
                >Documentos y más</span
              >
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="relative shrink-0 text-gray-500 group-hover:text-[#64ffda] group-hover:translate-x-1 transition-all duration-300 ml-auto"
              ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                d="M9 6l6 6l-6 6"></path></svg
            >
          </a>
        </div>
        <div class="flex flex-col">
          <h2
            class="text-2xl text-center sm:text-left text-white my-5 whitespace-nowrap"
          >
            Información Importante
          </h2>
          <div class="flex flex-col justify-center items-center gap-1">
            {
              events.map((item) => {
                return (
                  <div class="flex justify-between items-center gap-5 bg-[#040d1c] text-white rounded-xl px-4 py-4 w-full border border-transparent transition-all duration-300 ">
                    <div class="flex flex-col justify-center items-center ">
                      <span
                        data-date={item.date_end}
                        class="event-status size-2 rounded-full mb-1"
                      />
                      <span class="event-label text-[10px] font-medium mb-1" />
                      <span class="text-cyan-500 font-bold text-3xl">
                        {item.date.split(' ')[0]}
                      </span>
                      <span class="text-normal text-gray-400">
                        {item.date.split(' ')[2]}
                      </span>
                    </div>
                    <div class="flex flex-col justify-start items-start flex-1">
                      <h2 class="mb-2 font-bold whitespace-nowrap">
                        {item.title}
                      </h2>
                      <p class=" text-[#cdd7f7] flex flex-col gap-2 ">
                        <span class="text-xs">{item.description}</span>
                        <span class="text-[9px] text-gray-400">
                          {item.time}
                        </span>
                      </p>
                    </div>
                  </div>
                )
              })
            }
          </div>
        </div>
      </aside>
    </main>
  </Container>
  <Footer />
</Layout>

<style>
  .stagger-item {
    opacity: 0;
    animation: staggerFadeIn 0.5s ease forwards;
  }

  @keyframes staggerFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  import { actions } from 'astro:actions'

  function initSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement
    const box = document.getElementById('suggestions') as HTMLDivElement
    if (!input || !box) return

    let timer: ReturnType<typeof setTimeout>

    input.addEventListener('input', () => {
      clearTimeout(timer)
      const q = input.value.trim()
      if (q.length < 2) {
        box.style.display = 'none'
        return
      }

      timer = setTimeout(async () => {
        const res = await fetch('/api/search-suggestions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: q, type: 'course' })
        })
        const { suggestions } = await res.json()
        if (!suggestions?.length) {
          box.style.display = 'none'
          return
        }

        box.innerHTML = suggestions
          .map(
            (s: { title: string }) =>
              `<a href="/loginEstudiante?search=${encodeURIComponent(s.title)}" style="display:block;padding:10px 16px;color:#ccd6f6;font-size:14px;text-decoration:none;border-bottom:1px solid #1a3350;" onmouseover="this.style.background='#1a3350'" onmouseout="this.style.background='transparent'">${s.title}</a>`
          )
          .join('')
        box.style.display = 'block'
      }, 300)
    })

    box.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a')
      if (a) window.location.href = a.href
    })

    input.addEventListener('focus', () => {
      if (box.innerHTML) box.style.display = 'block'
    })

    document.addEventListener('click', (e) => {
      if (
        !input.contains(e.target as Node) &&
        !box.contains(e.target as Node)
      ) {
        box.style.display = 'none'
      }
    })

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') box.style.display = 'none'
    })

    const logout = document.getElementById('logout') as HTMLButtonElement
    logout?.addEventListener('click', () => {
      actions.logout()
      window.location.href = '/'
    })

    const date = document.querySelectorAll(
      '[data-date]'
    ) as NodeListOf<HTMLSpanElement>

    const dateNoW = new Date()

    date.forEach((item) => {
      const dateAttr = item.dataset.date
      if (!dateAttr) return

      const [day, month, year] = dateAttr.split('/').map(Number)

      if (!day || !month || !year) return
      const dateEvent = new Date(year, month - 1, day)
      const label = item
        .closest('.flex')
        ?.querySelector('.event-label') as HTMLSpanElement
      if (dateEvent > dateNoW) {
        item.classList.add('bg-green-500', 'animate-pulse')
        if (label) label.textContent = 'Próximo'
        label?.classList.add('text-green-400')
      } else {
        item.classList.add('bg-red-500')
        if (label) label.textContent = 'Finalizado'
        label?.classList.add('text-red-400')
      }
    })
  }

  document.addEventListener('astro:page-load', initSearch)
  document.addEventListener('DOMContentLoaded', initSearch)
</script>
