---
import { actions } from 'astro:actions'
import Layout from '../layouts/Layout.astro'
import Header from '@components/Shared/Header.astro'
import Footer from '@components/Shared/Footer.astro'
import Linkedin from '@assets/socials/Linkedin.astro'
import X from '@assets/socials/X.astro'
import Github from '@assets/socials/GitHub.astro'
---

<Layout
  title="Contáctanos | Soporte y Asesoría Personalizada en InfoByte"
  description="Página diseñada para que los usuarios puedan comunicarse de manera directa. Incluye formulario o información de contacto para solicitudes, consultas académicas, soporte técnico o requerimientos de servicios."
>
  <div class="flex flex-col min-h-screen">
    <Header />

    <main class="flex-1">
      <!-- Hero -->
      <section class="pt-20 pb-12 px-4 sm:px-6 text-center">
        <div class="max-w-3xl mx-auto">
          <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">
            Ponte en <span class="text-[#64ffda]">contacto</span>
          </h1>
          <p class="text-[#8892b0] text-lg max-w-xl mx-auto">
            ¿Tienes alguna pregunta o sugerencia? Nos encantaría escucharte.
            Completa el formulario o directamente por nuestros canales.
          </p>
        </div>
      </section>

      <!-- Content -->
      <section class="px-4 sm:px-6 pb-20">
        <div class="max-w-5xl mx-auto grid lg:grid-cols-5 gap-8">
          <!-- Form -->
          <div class="lg:col-span-3">
            <div
              class="bg-[#112240]/50 border border-[#1a3350] rounded-2xl p-6 sm:p-8"
            >
              <h2 class="text-xl font-semibold text-white mb-1">
                Envíanos un mensaje
              </h2>
              <p class="text-sm text-[#8892b0] mb-6">
                Completa el formulario y te responderemos pronto.
              </p>

              <form id="contact-form" class="flex flex-col gap-4">
                <div class="grid sm:grid-cols-2 gap-4">
                  <div class="flex flex-col gap-1.5">
                    <label for="name" class="text-sm font-medium text-[#ccd6f6]"
                      >Nombre completo</label
                    >
                    <input
                      type="text"
                      name="name"
                      id="name"
                      placeholder="Tu nombre"
                      required
                      class="w-full px-4 py-2.5 bg-[#0b192f] border border-[#1a3350] rounded-xl text-sm text-[#ccd6f6] placeholder-[#8892b0]/50 outline-none focus:border-[#64ffda]/50 transition-colors"
                    />
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label
                      for="email"
                      class="text-sm font-medium text-[#ccd6f6]"
                      >Correo electrónico</label
                    >
                    <input
                      type="email"
                      name="email"
                      id="email"
                      placeholder="tu@correo.com"
                      required
                      class="w-full px-4 py-2.5 bg-[#0b192f] border border-[#1a3350] rounded-xl text-sm text-[#ccd6f6] placeholder-[#8892b0]/50 outline-none focus:border-[#64ffda]/50 transition-colors"
                    />
                  </div>
                </div>
                <div class="flex flex-col gap-1.5">
                  <label
                    for="message"
                    class="text-sm font-medium text-[#ccd6f6]">Mensaje</label
                  >
                  <textarea
                    name="message"
                    id="message"
                    rows="5"
                    placeholder="¿En qué podemos ayudarte?"
                    required
                    class="w-full px-4 py-2.5 bg-[#0b192f] border border-[#1a3350] rounded-xl text-sm text-[#ccd6f6] placeholder-[#8892b0]/50 outline-none focus:border-[#64ffda]/50 transition-colors resize-none"
                  ></textarea>
                </div>
                <button
                  type="submit"
                  id="btn-submit"
                  class="w-full sm:w-auto px-8 py-3 bg-[#64ffda] hover:bg-[#64ffda]/90 text-[#0b192f] font-semibold text-sm rounded-xl transition-all duration-200 active:scale-[0.98] cursor-pointer"
                >
                  Enviar mensaje
                </button>
              </form>
            </div>
          </div>

          <!-- Contact Info -->
          <div class="lg:col-span-2 flex flex-col gap-4">
            <!-- Email Card -->
            <div
              class="bg-[#112240]/50 border border-[#1a3350] rounded-2xl p-6 flex items-start gap-4"
            >
              <div
                class="size-10 shrink-0 rounded-xl bg-[#64ffda]/10 flex items-center justify-center"
              >
                <svg
                  class="size-5 text-[#64ffda]"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-white mb-0.5">
                  Correo electrónico
                </h3>
                <a
                  href="mailto:nestnidev17@gmail.com"
                  class="text-sm text-[#64ffda] hover:underline"
                >
                  nestnidev17@gmail.com
                </a>
              </div>
            </div>

            <!-- Social Card -->
            <div
              class="bg-[#112240]/50 border border-[#1a3350] rounded-2xl p-6"
            >
              <div class="flex items-center gap-4 mb-4">
                <div
                  class="size-10 shrink-0 rounded-xl bg-[#64ffda]/10 flex items-center justify-center"
                >
                  <svg
                    class="size-5 text-[#64ffda]"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m9.86-4.186a4.5 4.5 0 0 0-1.242-7.244l-4.5-4.5a4.5 4.5 0 0 0-6.364 6.364L4.34 8.374"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-white">
                    Redes sociales
                  </h3>
                  <p class="text-xs text-[#8892b0]">
                    Síguenos para estar al día
                  </p>
                </div>
              </div>
              <div class="flex gap-3">
                <a
                  href="https://www.linkedin.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Linkedin class="size-6" />
                </a>
                <a
                  href="https://x.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <X class="size-6" />
                </a>
                <a
                  href="https://www.github.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Github class="size-6" />
                </a>
              </div>
            </div>

            <!-- Response Card -->
            <div
              class="bg-[#64ffda]/5 border border-[#64ffda]/15 rounded-2xl p-6"
            >
              <div class="flex items-start gap-4">
                <div
                  class="size-10 shrink-0 rounded-xl bg-[#64ffda]/10 flex items-center justify-center"
                >
                  <svg
                    class="size-5 text-[#64ffda]"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-white mb-0.5">
                    Tiempo de respuesta
                  </h3>
                  <p class="text-xs text-[#8892b0]">
                    Respondemos en menos de 24 horas hábiles.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>

  <script>
    import { actions } from 'astro:actions'
    import Toastify from 'toastify-js'
    import 'toastify-js/src/toastify.css'

    document.addEventListener('astro:page-load', () => {
      const form = document.querySelector('#contact-form') as HTMLFormElement
      const btnSubmit = document.querySelector(
        '#btn-submit'
      ) as HTMLButtonElement

      form?.addEventListener('submit', async (e) => {
        e.preventDefault()
        btnSubmit.setAttribute('disabled', 'disabled')
        btnSubmit.textContent = 'Enviando...'

        const formData = new FormData(form)
        const name = formData.get('name') as string
        const email = formData.get('email') as string
        const message = formData.get('message') as string

        const { data, error } = await actions.getForm({ name, email, message })

        if (error) {
          Toastify({
            text: 'Hubo un error al enviar el formulario',
            duration: 3000,
            close: true,
            gravity: 'bottom',
            position: 'center',
            style: {
              background: 'linear-gradient(to right, #FF4B26)',
              borderRadius: '12px',
              boxShadow: '0 0 30px rgba(255, 75, 38, 0.3)',
              padding: '12px 20px',
              fontSize: '14px'
            }
          }).showToast()
          btnSubmit.removeAttribute('disabled')
          btnSubmit.textContent = 'Enviar mensaje'
          return
        }

        if (data) {
          Toastify({
            text: '¡Mensaje enviado correctamente!',
            duration: 3000,
            close: true,
            gravity: 'bottom',
            position: 'center',
            style: {
              background: 'linear-gradient(to right, #00b09b, #96c93d)',
              borderRadius: '12px',
              boxShadow: '0 0 30px rgba(0, 176, 155, 0.3)',
              padding: '12px 20px',
              fontSize: '14px'
            }
          }).showToast()
          form.reset()
          btnSubmit.removeAttribute('disabled')
          btnSubmit.textContent = 'Enviar mensaje'
        }
      })
    })
  </script>
</Layout>
