---
import Google from '@assets/socials/Google.astro'
import AuthLayout from '@layouts/AuthLayout.astro'
import Input from '@components/Shared/Input.astro'

const email = Astro.cookies.get('email')?.value ?? ''
const rememberMe = !!email
---

<AuthLayout
  title="Iniciar Sesión en InfoByte | Accede a Tu Cuenta"
  page="Inicio de Sesión"
>
  <div id="error-message" class="hidden mb-4 p-3 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-sm text-center">
  </div>

  <button
    id="btn-google"
    type="button"
    class="w-full py-3 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-white rounded-xl text-sm font-medium transition-all duration-200 flex items-center justify-center gap-3 active:scale-[0.98]"
  >
    <Google class="size-5" />
    Continuar con Google
  </button>

  <div class="flex items-center gap-3 my-5">
    <div class="flex-1 h-px bg-white/10"></div>
    <span class="text-xs text-[var(--letter)]/40 uppercase tracking-wider">o</span>
    <div class="flex-1 h-px bg-white/10"></div>
  </div>

  <form id="login-form" class="flex flex-col gap-4">
    <Input
      name="email"
      type="email"
      label="Correo electrónico"
      placeholder="tucorreo@ejemplo.com"
      value={email}
      required={true}
    />

    <Input
      name="password"
      type="password"
      label="Contraseña"
      placeholder="••••••••"
      required={true}
    />

    <div class="flex items-center justify-between mt-1">
      <label class="flex items-center gap-2 cursor-pointer group">
        <input
          type="checkbox"
          name="remember_me"
          checked={rememberMe}
          class="w-4 h-4 rounded border-white/20 bg-[#1f293a] text-[var(--colorAquamarine)] focus:ring-[var(--colorAquamarine)]/30 accent-[var(--colorAquamarine)] cursor-pointer"
        />
        <span class="text-xs text-[var(--letter)]/60 group-hover:text-[var(--letter)]/80 transition-colors">
          Recordarme
        </span>
      </label>
      <a href="#" class="text-xs text-[var(--colorAquamarine)]/70 hover:text-[var(--colorAquamarine)] transition-colors">
        ¿Olvidaste tu contraseña?
      </a>
    </div>

    <button
      type="submit"
      id="btn-submit"
      class="w-full py-3 mt-1 bg-[var(--colorAquamarine)] hover:brightness-110 text-[var(--fondo)] font-semibold text-sm rounded-xl transition-all duration-200 active:scale-[0.98] cursor-pointer"
    >
      Iniciar sesión
    </button>
  </form>

  <p class="text-center text-sm text-[var(--letter)]/50 mt-6">
    ¿No tienes cuenta?
    <a href="/registro" class="text-[var(--colorAquamarine)] hover:underline font-medium">
      Regístrate
    </a>
  </p>
</AuthLayout>

<script>
  import { actions } from 'astro:actions'
  import { signInWithPopup, GoogleAuthProvider, signInWithEmailAndPassword } from 'firebase/auth'
  import { firebase } from '../firebase/config'

  document.addEventListener('astro:page-load', () => {
    const btnGoogle = document.querySelector('#btn-google') as HTMLButtonElement
    const form = document.querySelector('#login-form') as HTMLFormElement
    const btnSubmit = document.querySelector('#btn-submit') as HTMLButtonElement
    const errorDiv = document.querySelector('#error-message') as HTMLDivElement

    function showError(msg: string) {
      errorDiv.textContent = msg
      errorDiv.classList.remove('hidden')
    }

    function hideError() {
      errorDiv.classList.add('hidden')
    }

    function setLoading(loading: boolean) {
      if (loading) {
        btnSubmit.setAttribute('disabled', 'disabled')
        btnSubmit.textContent = 'Iniciando sesión...'
        btnGoogle.setAttribute('disabled', 'disabled')
      } else {
        btnSubmit.removeAttribute('disabled')
        btnSubmit.textContent = 'Iniciar sesión'
        btnGoogle.removeAttribute('disabled')
      }
    }

    btnGoogle.addEventListener('click', async () => {
      hideError()
      setLoading(true)
      const provider = new GoogleAuthProvider()

      try {
        const credential = await signInWithPopup(firebase.auth, provider)
        const { error } = await actions.loginWithGoogle(credential)

        if (error) {
          showError('Error al iniciar sesión con Google. Intenta de nuevo.')
          setLoading(false)
          return
        }

        window.location.replace('/loginEstudiante')
      } catch (err: any) {
        if (err.code !== 'auth/popup-closed-by-user') {
          showError('No se pudo completar el inicio de sesión con Google.')
        }
        setLoading(false)
      }
    })

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      hideError()
      setLoading(true)

      const formData = new FormData(form)
      const emailVal = formData.get('email') as string
      const passwordVal = formData.get('password') as string
      const rememberMe = formData.get('remember_me') === 'on'

      try {
        const credential = await signInWithEmailAndPassword(
          firebase.auth,
          emailVal,
          passwordVal
        )

        const { error } = await actions.loginUser({
          email: emailVal,
          password: passwordVal,
          remember_me: rememberMe,
        })

        if (error) {
          showError('Credenciales incorrectas. Verifica tu correo y contraseña.')
          setLoading(false)
          return
        }

        window.location.replace('/loginEstudiante')
      } catch (err: any) {
        if (err.code === 'auth/invalid-credential' || err.code === 'auth/wrong-password' || err.code === 'auth/user-not-found') {
          showError('Correo electrónico o contraseña incorrectos.')
        } else if (err.code === 'auth/too-many-requests') {
          showError('Demasiados intentos. Intenta de nuevo más tarde.')
        } else {
          showError('Ocurrió un error al iniciar sesión.')
        }
        setLoading(false)
      }
    })
  })
</script>
