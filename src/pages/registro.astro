---
import AuthLayout from '@layouts/AuthLayout.astro'
import Input from '@components/Shared/Input.astro'
---

<AuthLayout
  title="Regístrate en InfoByte | Crea Tu Cuenta"
  page="Registro"
>
  <div id="error-message" class="hidden mb-4 p-3 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-sm text-center">
  </div>

  <form id="register-form" class="flex flex-col gap-4">
    <Input
      name="name"
      type="text"
      label="Nombre completo"
      placeholder="Carlos Rodríguez"
      required={true}
    />

    <Input
      name="email"
      type="email"
      label="Correo electrónico"
      placeholder="tucorreo@ejemplo.com"
      required={true}
    />

    <Input
      name="password"
      type="password"
      label="Contraseña"
      placeholder="••••••••"
      required={true}
    />

    <button
      type="submit"
      id="btn-submit"
      class="w-full py-3 mt-1 bg-[var(--colorAquamarine)] hover:brightness-110 text-[var(--fondo)] font-semibold text-sm rounded-xl transition-all duration-200 active:scale-[0.98] cursor-pointer"
    >
      Crear cuenta
    </button>
  </form>

  <p class="text-center text-sm text-[var(--letter)]/50 mt-6">
    ¿Ya tienes cuenta?
    <a href="/inicioSesion" class="text-[var(--colorAquamarine)] hover:underline font-medium">
      Inicia sesión
    </a>
  </p>
</AuthLayout>

<script>
  import { actions } from 'astro:actions'

  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector('#register-form') as HTMLFormElement
    const btnSubmit = document.querySelector('#btn-submit') as HTMLButtonElement
    const errorDiv = document.querySelector('#error-message') as HTMLDivElement

    function showError(msg: string) {
      errorDiv.textContent = msg
      errorDiv.classList.remove('hidden')
    }

    function hideError() {
      errorDiv.classList.add('hidden')
    }

    function setLoading(loading: boolean) {
      if (loading) {
        btnSubmit.setAttribute('disabled', 'disabled')
        btnSubmit.textContent = 'Creando cuenta...'
      } else {
        btnSubmit.removeAttribute('disabled')
        btnSubmit.textContent = 'Crear cuenta'
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      hideError()
      setLoading(true)

      const formData = new FormData(form)

      const { data, error } = await actions.registerUser(formData)

      if (error) {
        if (error.message?.includes('email-already-in-use')) {
          showError('Este correo electrónico ya está registrado.')
        } else if (error.message?.includes('weak-password')) {
          showError('La contraseña debe tener al menos 6 caracteres.')
        } else {
          showError('Ocurrió un error al crear la cuenta. Intenta de nuevo.')
        }
        setLoading(false)
        return
      }

      window.location.replace('/loginEstudiante')
    })
  })
</script>
