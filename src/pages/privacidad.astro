---
import Footer from '@components/Shared/Footer.astro'
import Header from '@components/Shared/Header.astro'
import Layout from '@layouts/Layout.astro'

const sections = [
  { id: 'info', num: '1', title: 'Información que Recopilamos' },
  { id: 'uso', num: '2', title: 'Cómo Utilizamos tu Información' },
  { id: 'seguridad', num: '3', title: 'Seguridad de la Información' },
  { id: 'cookies', num: '4', title: 'Uso de Cookies' },
  { id: 'derechos', num: '5', title: 'Acceso, Modificación y Eliminación' },
  { id: 'compartir', num: '6', title: 'Compartir tu Información' },
  { id: 'enlaces', num: '7', title: 'Enlaces a Otros Sitios' },
  { id: 'cambios', num: '8', title: 'Cambios en esta Política' },
  { id: 'contacto', num: '9', title: 'Contacto' },
]
---

<Layout
  title="Política de Privacidad de InfoByte | Protege Tu Información Personal"
  description="Página que expone las políticas de privacidad y tratamiento de datos personales. Describe el uso, almacenamiento y protección de la información suministrada por los usuarios según normativa vigente."
>
  <div class="flex flex-col min-h-screen">
    <Header />

    <main class="flex-1">
      <!-- Hero -->
      <section class="pt-24 pb-12 px-4 sm:px-6 text-center">
        <div class="max-w-3xl mx-auto">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#64ffda]/10 border border-[#64ffda]/20 text-[#64ffda] text-xs font-medium mb-6">
            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
            Política de Privacidad
          </div>
          <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">
            Protección de <span class="text-[#64ffda]">datos</span>
          </h1>
          <p class="text-[#8892b0] text-lg max-w-xl mx-auto mb-3">
            Tu privacidad es nuestra prioridad. Conoce cómo recopilamos, utilizamos y protegemos tu información.
          </p>
          <p class="text-sm text-[#8892b0]/60">
            Última actualización: 20 de octubre de 2025
          </p>
        </div>
      </section>

      <!-- Content -->
      <section class="px-4 sm:px-6 pb-24">
        <div class="max-w-5xl mx-auto grid lg:grid-cols-4 gap-8">
          <!-- TOC Sidebar -->
          <aside class="lg:col-span-1 hidden lg:block">
            <div class="sticky top-24 bg-[#112240]/50 border border-[#1a3350] rounded-2xl p-5">
              <h3 class="text-xs font-semibold text-[#8892b0] uppercase tracking-wider mb-3">Contenido</h3>
              <nav class="flex flex-col gap-0.5">
                {sections.map((s) => (
                  <a
                    href={`#${s.id}`}
                    class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-[#8892b0] hover:text-[#64ffda] hover:bg-[#64ffda]/5 transition-all duration-200"
                  >
                    <span class="size-5 shrink-0 rounded-md bg-[#64ffda]/10 text-[#64ffda] text-[10px] font-bold flex items-center justify-center">
                      {s.num}
                    </span>
                    {s.title}
                  </a>
                ))}
              </nav>
            </div>
          </aside>

          <!-- Main Content -->
          <div class="lg:col-span-3 flex flex-col gap-6">
            <!-- Intro Card -->
            <div class="bg-[#112240]/50 border border-[#1a3350] rounded-2xl p-6 sm:p-8">
              <p class="text-[#ccd6f6] leading-relaxed">
                En <strong class="text-[#64ffda]">InfoByte</strong>, nos comprometemos a proteger tu privacidad y
                garantizar que tu experiencia en nuestro sitio sea segura y confiable.
                Esta política describe cómo recopilamos, utilizamos y
                protegemos la información personal que proporcionas al acceder y utilizar nuestros servicios.
              </p>
            </div>

            <!-- Section 1 -->
            <div id="info" class="bg-[#112240]/50 border border-[#1a3350] rounded-2xl p-6 sm:p-8">
              <div class="flex items-center gap-3 mb-4">
                <div class="size-9 shrink-0 rounded-xl bg-[#64ffda]/10 flex items-center justify-center">
                  <span class="text-[#64ffda] text-sm font-bold">1</span>
                </div>
                <h2 class="text-xl font-semibold text-white">Información que Recopilamos</h2>
              </div>
              <p class="text-[#8892b0] mb-4">Recopilamos la siguiente información cuando te registras y utilizas nuestros servicios:</p>
              <div class="grid sm:grid-cols-3 gap-3">
                <div class="bg-[#0b192f] border border-[#1a3350] rounded-xl p-4">
                  <div class="size-8 rounded-lg bg-[#64ffda]/10 flex items-center justify-center mb-3">
                    <svg class="size-4 text-[#64ffda]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                    </svg>
                  </div>
                  <h3 class="text-sm font-medium text-white mb-1">Datos de Registro</h3>
                  <p class="text-xs text-[#8892b0]">Nombre, correo electrónico y contraseña para crear tu cuenta.</p>
                </div>
                <div class="bg-[#0b192f] border border-[#1a3350] rounded-xl p-4">
                  <div class="size-8 rounded-lg bg-[#64ffda]/10 flex items-center justify-center mb-3">
                    <svg class="size-4 text-[#64ffda]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.264.26-2.467.729-3.568" />
                    </svg>
                  </div>
                  <h3 class="text-sm font-medium text-white mb-1">Datos de Navegación</h3>
                  <p class="text-xs text-[#8892b0]">Dispositivo, ubicación, IP y actividad en el sitio.</p>
                </div>
                <div class="bg-[#0b192f] border border-[#1a3350] rounded-xl p-4">
                  <div class="size-8 rounded-lg bg-[#64ffda]/10 flex items-center justify-center mb-3">
                    <svg class="size-4 text-[#64ffda]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
                    </svg>
                  </div>
                  <h3 class="text-sm font-medium text-white mb-1">Datos de Cursos</h3>
                  <p class="text-xs text-[#8892b0]">Cursos visualizados, intereses y progreso.</p>
                </div>
              </div>
            </div>

            <!-- Section 2 -->
            <div id="uso" class="bg-[#112240]/50 border border-[#1a3350] rounded-2xl p-6 sm:p-8">
              <div class="flex items-center gap-3 mb-4">
                <div class="size-9 shrink-0 rounded-xl bg-[#64ffda]/10 flex items-center justify-center">
                  <span class="text-[#64ffda] text-sm font-bold">2</span>
                </div>
                <h2 class="text-xl font-semibold text-white">Cómo Utilizamos tu Información</h2>
              </div>
              <p class="text-[#8892b0] mb-4">La información recopilada se utiliza para:</p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <div class="size-5 shrink-0 rounded-md bg-[#64ffda]/10 flex items-center justify-center mt-0.5">
                    <svg class="size-3 text-[#64ffda]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-[#ccd6f6] font-medium">Proveer los servicios</p>
                    <p class="text-xs text-[#8892b0]">Gestionar tu cuenta, darte acceso a cursos y recursos, y personalizar tu experiencia.</p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <div class="size-5 shrink-0 rounded-md bg-[#64ffda]/10 flex items-center justify-center mt-0.5">
                    <svg class="size-3 text-[#64ffda]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-[#ccd6f6] font-medium">Mejorar nuestro sitio</p>
                    <p class="text-xs text-[#8892b0]">Analizar tu actividad para optimizar servicios y contenido.</p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <div class="size-5 shrink-0 rounded-md bg-[#64ffda]/10 flex items-center justify-center mt-0.5">
                    <svg class="size-3 text-[#64ffda]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-[#ccd6f6] font-medium">Comunicaciones</p>
                    <p class="text-xs text-[#8892b0]">Enviarte correos sobre tu cuenta, nuevos cursos y notificaciones importantes.</p>
                  </div>
                </li>
              </ul>
            </div>

            <!-- Section 3 -->
            <div id="seguridad" class="bg-[#112240]/50 border border-[#1a3350] rounded-2xl p-6 sm:p-8">
              <div class="flex items-center gap-3 mb-4">
                <div class="size-9 shrink-0 rounded-xl bg-[#64ffda]/10 flex items-center justify-center">
                  <span class="text-[#64ffda] text-sm font-bold">3</span>
                </div>
                <h2 class="text-xl font-semibold text-white">Seguridad de la Información</h2>
              </div>
              <p class="text-[#8892b0] leading-relaxed">
                Tomamos medidas de seguridad razonables para proteger tu información personal contra acceso no autorizado, alteración o destrucción. Usamos tecnologías de encriptación y seguimos las mejores prácticas de la industria para mantener la confidencialidad de tus datos.
              </p>
            </div>

            <!-- Section 4 -->
            <div id="cookies" class="bg-[#112240]/50 border border-[#1a3350] rounded-2xl p-6 sm:p-8">
              <div class="flex items-center gap-3 mb-4">
                <div class="size-9 shrink-0 rounded-xl bg-[#64ffda]/10 flex items-center justify-center">
                  <span class="text-[#64ffda] text-sm font-bold">4</span>
                </div>
                <h2 class="text-xl font-semibold text-white">Uso de Cookies</h2>
              </div>
              <p class="text-[#8892b0] leading-relaxed">
                Utilizamos cookies para mejorar tu experiencia en nuestro sitio. Las cookies son pequeños archivos almacenados en tu dispositivo que nos permiten personalizar tu experiencia, mantener tu sesión activa y analizar el tráfico web.
              </p>
            </div>

            <!-- Section 5 -->
            <div id="derechos" class="bg-[#112240]/50 border border-[#1a3350] rounded-2xl p-6 sm:p-8">
              <div class="flex items-center gap-3 mb-4">
                <div class="size-9 shrink-0 rounded-xl bg-[#64ffda]/10 flex items-center justify-center">
                  <span class="text-[#64ffda] text-sm font-bold">5</span>
                </div>
                <h2 class="text-xl font-semibold text-white">Acceso, Modificación y Eliminación</h2>
              </div>
              <p class="text-[#8892b0] leading-relaxed">
                Tienes el derecho de acceder, corregir o eliminar tu información personal en cualquier momento. Puedes hacerlo accediendo a la configuración de tu cuenta o poniéndote en contacto con nosotros a través de los medios proporcionados en el sitio.
              </p>
            </div>

            <!-- Section 6 -->
            <div id="compartir" class="bg-[#112240]/50 border border-[#1a3350] rounded-2xl p-6 sm:p-8">
              <div class="flex items-center gap-3 mb-4">
                <div class="size-9 shrink-0 rounded-xl bg-[#64ffda]/10 flex items-center justify-center">
                  <span class="text-[#64ffda] text-sm font-bold">6</span>
                </div>
                <h2 class="text-xl font-semibold text-white">Compartir tu Información</h2>
              </div>
              <p class="text-[#8892b0] mb-4">No vendemos, alquilamos ni compartimos tu información personal con terceros, excepto en los siguientes casos:</p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <div class="size-5 shrink-0 rounded-md bg-[#64ffda]/10 flex items-center justify-center mt-0.5">
                    <svg class="size-3 text-[#64ffda]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-[#ccd6f6] font-medium">Proveedores de Servicios</p>
                    <p class="text-xs text-[#8892b0]">Compartimos información con proveedores que nos ayudan a operar el sitio (hosting, etc.).</p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <div class="size-5 shrink-0 rounded-md bg-[#64ffda]/10 flex items-center justify-center mt-0.5">
                    <svg class="size-3 text-[#64ffda]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-[#ccd6f6] font-medium">Obligaciones Legales</p>
                    <p class="text-xs text-[#8892b0]">Si es requerido por la ley o en respuesta a un proceso legal.</p>
                  </div>
                </li>
              </ul>
            </div>

            <!-- Section 7 -->
            <div id="enlaces" class="bg-[#112240]/50 border border-[#1a3350] rounded-2xl p-6 sm:p-8">
              <div class="flex items-center gap-3 mb-4">
                <div class="size-9 shrink-0 rounded-xl bg-[#64ffda]/10 flex items-center justify-center">
                  <span class="text-[#64ffda] text-sm font-bold">7</span>
                </div>
                <h2 class="text-xl font-semibold text-white">Enlaces a Otros Sitios</h2>
              </div>
              <p class="text-[#8892b0] leading-relaxed">
                Nuestro sitio puede contener enlaces a otros sitios web. No somos responsables de las prácticas de privacidad de esos sitios. Te recomendamos leer sus políticas de privacidad antes de proporcionarles cualquier información personal.
              </p>
            </div>

            <!-- Section 8 -->
            <div id="cambios" class="bg-[#112240]/50 border border-[#1a3350] rounded-2xl p-6 sm:p-8">
              <div class="flex items-center gap-3 mb-4">
                <div class="size-9 shrink-0 rounded-xl bg-[#64ffda]/10 flex items-center justify-center">
                  <span class="text-[#64ffda] text-sm font-bold">8</span>
                </div>
                <h2 class="text-xl font-semibold text-white">Cambios en esta Política</h2>
              </div>
              <p class="text-[#8892b0] leading-relaxed">
                Nos reservamos el derecho de modificar esta política de privacidad en cualquier momento. Cualquier cambio será publicado en esta página con la fecha de la última actualización. Te recomendamos revisar esta página regularmente.
              </p>
            </div>

            <!-- Section 9 -->
            <div id="contacto" class="bg-[#64ffda]/5 border border-[#64ffda]/15 rounded-2xl p-6 sm:p-8">
              <div class="flex items-center gap-3 mb-4">
                <div class="size-9 shrink-0 rounded-xl bg-[#64ffda]/10 flex items-center justify-center">
                  <span class="text-[#64ffda] text-sm font-bold">9</span>
                </div>
                <h2 class="text-xl font-semibold text-white">Contacto</h2>
              </div>
              <p class="text-[#8892b0] mb-4">Si tienes alguna pregunta sobre esta política, no dudes en contactarnos:</p>
              <div class="flex flex-col sm:flex-row gap-3">
                <a href="mailto:nestnidev17@gmail.com" class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#0b192f] border border-[#1a3350] rounded-xl text-sm text-[#64ffda] hover:border-[#64ffda]/30 transition-colors">
                  <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                  </svg>
                  nestnidev17@gmail.com
                </a>
                <a href="/contacto" class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#64ffda] hover:bg-[#64ffda]/90 text-[#0b192f] font-semibold text-sm rounded-xl transition-all duration-200 active:scale-[0.98]">
                  <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                  </svg>
                  Ir a contacto
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
