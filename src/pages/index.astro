---
import Footer from '@components/Shared/Footer.astro'
import Header from '@components/Shared/Header.astro'
import Main from '@components/Index/Main.astro'
import Layout from '@layouts/Layout.astro'
---

<Layout
  title="InfoByte | Innovación y Tecnología a Tu Alcance"
  description="Página principal de InfoByte. Presenta la información introductoria, los servicios y los accesos más importantes, ofreciendo una visión general de la propuesta tecnológica y académica del proyecto."
>
  <a
    href="#contenido"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-[var(--colorAquamarine)] focus:text-[var(--fondo)] focus:px-4 focus:py-2 focus:rounded-lg focus:font-semibold focus:outline-none"
  >
    Saltar al contenido
  </a>
  <Header />
  <Main />
  <Footer />
</Layout>
